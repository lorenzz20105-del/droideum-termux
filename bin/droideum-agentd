# ---------------------------------------------------------------------------
# MCP server (JSON-RPC 2.0 over stdio)
# ---------------------------------------------------------------------------
def tool_schemas():
    out = []
    for name, spec in TOOLS.items():
        props, required = {}, []
        for pname, pdesc in spec.get("params", {}).items():
            desc, ptype = pdesc, "string"
            head = pdesc.split(" ")[0].lower()
            if head.startswith("int"):
                ptype = "integer"
            elif head.startswith("float"):
                ptype = "number"
            elif head.startswith("bool"):
                ptype = "boolean"
            elif head.startswith("list"):
                ptype = "array"
            props[pname] = {"type": ptype, "description": desc}
            if "required" in pdesc:
                required.append(pname)
        schema = {"type": "object", "properties": props, "additionalProperties": False}
        if required:
            schema["required"] = required
        out.append({"name": name, "description": spec["desc"], "inputSchema": schema})
    return out


def call_tool(name, args):
    spec = TOOLS.get(name)
    if not spec:
        raise ToolError(f"unknown tool: {name}", hint=f"available: {', '.join(sorted(TOOLS))}",
                        code="UNKNOWN_TOOL")
    try:
        result = spec["fn"](args or {})
    except KeyError as e:
        raise ToolError(f"missing required parameter {e}", code="BAD_ARGS")
    except ToolError:
        raise
    except Exception as e:  # never let a bug kill the server
        raise ToolError(f"{type(e).__name__}: {e}", code="INTERNAL")
    if isinstance(result, dict) and "_content" in result:
        structured = result.get("_structured")
        content = result["_content"]
        return {"content": content, "structuredContent": structured, "isError": False}
    payload = {"content": [{"type": "text", "text": json.dumps(result)}], "structuredContent": result,
               "isError": False}
    return payload


def error_result(e):
    payload = {"error": str(e), "code": e.code}
    if e.hint:
        payload["hint"] = e.hint
    return {"content": [{"type": "text", "text": json.dumps(payload)}], "isError": True}


def handle(msg):
    method = msg.get("method")
    mid = msg.get("id")
    params = msg.get("params") or {}

    if method == "initialize":
        requested = params.get("protocolVersion")
        version = requested if requested in PROTOCOL_VERSIONS else "2024-11-05"
        return {
            "protocolVersion": version,
            "capabilities": {"tools": {"listChanged": False}, "prompts": {"listChanged": False},
                             "resources": {"listChanged": False}},
            "serverInfo": {"name": SERVER_NAME, "version": SERVER_VERSION},
            "instructions": (
                "This server drives an Android VM (Android-x86 under QEMU inside a Termux proot "
                "container). Typical loop: observe -> decide -> act -> wait.idle -> observe. "
                "Coordinates are device pixels; get them from ui.dump `xy` or ui.find `center`, "
                "never guess. Screens take 1-3s to update after a tap. Use task.checkpoint before "
                "risky sequences and task.rollback to undo them."
            ),
        }
    if method == "tools/list":
        return {"tools": tool_schemas()}
    if method == "tools/call":
        name = params.get("name")
        args = params.get("arguments") or {}
        try:
            return call_tool(name, args)
        except ToolError as e:
            log(f"tool {name} failed: {e}")
            return error_result(e)
    if method == "prompts/list":
        return {"prompts": [{
            "name": "drive_android_app",
            "description": "Boot the Android VM if needed and drive an app to a stated goal.",
            "arguments": [{"name": "app_package", "description": "package name to drive",
                           "required": True},
                          {"name": "goal", "description": "what to accomplish",
                           "required": True}],
        }]}
    if method == "prompts/get":
        a = {x["name"]: x.get("value") for x in params.get("arguments", [])}
        pkg, goal = a.get("app_package", "<package>"), a.get("goal", "<goal>")
        text = (
            f"Goal: {goal}\nApp: {pkg}\n\n"
            "1. device.status — confirm vm_running, adb, boot_completed.\n"
            f"2. app.launch {{package: \"{pkg}\"}} then wait.idle.\n"
            "3. observe {} — read the compact UI tree; note `xy` of actionable nodes.\n"
            "4. Act with input.tap / input.text / input.swipe, then wait.idle, then observe again.\n"
            "5. If the UI tree is empty (SurfaceView/game), use screen.capture and tap pixels.\n"
            "6. Use task.checkpoint before destructive steps; task.rollback to recover.\n"
            "7. Stop when the goal's success condition is visible in the UI tree; report what you saw."
        )
        return {"description": f"Drive {pkg} to: {goal}",
                "messages": [{"role": "user", "content": {"type": "text", "text": text}}]}
    if method == "resources/list":
        return {"resources": []}
    if method in ("notifications/initialized", "notifications/cancelled"):
        return None
    if method == "ping":
        return {}
    raise ToolError(f"method not found: {method}", code="METHOD_NOT_FOUND")


def serve(autostart=False, fresh=None):
    log(f"serving MCP on stdio (home={HOME}, serial={SERIAL})")
    if autostart:
        try:
            if fresh:
                log(f"rolling back to checkpoint {fresh}")
                monitor_command(f"loadvm {fresh}", timeout=240)
            if not vm_running():
                log("VM not running — starting headless (droideum up)")
                subprocess.run(["droideum", "up"], timeout=1800, check=False)
            wait_boot()
            ADB.ensure()
            log("device ready")
        except Exception as e:  # stay alive: the agent can still query device.status
            log(f"autostart problem: {e}")

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": None,
                                         "error": {"code": -32700, "message": "parse error"}}) + "\n")
            sys.stdout.flush()
            continue
        is_notification = "id" not in msg
        try:
            result = handle(msg)
        except ToolError as e:
            if not is_notification:
                sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": msg.get("id"),
                                             "error": {"code": -32601, "message": str(e)}}) + "\n")
                sys.stdout.flush()
            continue
        if not is_notification and result is not None:
            sys.stdout.write(json.dumps({"jsonrpc": "2.0", "id": msg.get("id"), "result": result}) + "\n")
            sys.stdout.flush()
    log("stdin closed, exiting")


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------
def main(argv):
    ap = argparse.ArgumentParser(prog="droideum-agentd", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")

    s = sub.add_parser("serve", help="MCP server on stdio")
    s.add_argument("--autostart", action="store_true", help="boot the VM and wait for Android if needed")
    s.add_argument("--fresh", metavar="CHECKPOINT", help="roll back to this checkpoint before serving")

    ls = sub.add_parser("list", help="print the tool catalogue as JSON")
    ls.add_argument("--brief", action="store_true", help="one line per tool, human readable")
    ls.add_argument("--names", action="store_true", help="just the tool names")

    c = sub.add_parser("call", help="call one tool and print JSON")
    c.add_argument("tool")
    c.add_argument("--json", default="{}", help="tool arguments as JSON")

    o = sub.add_parser("observe", help="human-readable single observation")
    o.add_argument("--screenshot", action="store_true")
    o.add_argument("--out", default=None, help="write the PNG here with --screenshot")

    sub.add_parser("selftest", help="offline checks (no device needed)")

    args = ap.parse_args(argv)

    if args.cmd == "serve":
        serve(autostart=args.autostart, fresh=args.fresh)
        return 0

    if args.cmd == "list":
        schemas = tool_schemas()
        if args.names:
            print("\n".join(t["name"] for t in schemas))
        elif args.brief:
            for t in schemas:
                first = t["description"].strip().split(". ")[0].rstrip(".")
                props = ", ".join(t["inputSchema"]["properties"]) or "-"
                print(f"{t['name']:<18} {props:<34} {first[:95]}")
        else:
            print(json.dumps(schemas, indent=2))
        return 0

    if args.cmd == "call":
        try:
            params = json.loads(args.json)
        except json.JSONDecodeError as e:
            print(json.dumps({"ok": False, "error": f"bad --json: {e}"}))
            return 2
        try:
            res = call_tool(args.tool, params)
        except ToolError as e:
            print(json.dumps(error_result(e), indent=2))
            return 1
        content = res.get("content") or []
        # keep binary payloads out of the terminal
        trimmed = [c for c in content if c.get("type") != "image"]
        print(json.dumps({"ok": not res.get("isError"), "content": trimmed,
                          "structured": res.get("structuredContent")}, indent=2))
        return 0

    if args.cmd == "observe":
        res = tool_observe({"include_ui": True, "include_screenshot": args.screenshot,
                            "only_interactive": True})
        structured = res["_structured"]
        print(json.dumps(structured.get("meta", {}), indent=2))
        ui = structured.get("ui") or {}
        print(f"\nUI: {ui.get('count', 0)} nodes"
              + (" (truncated)" if ui.get("truncated") else ""))
        for n in ui.get("nodes", []):
            label = n.get("text") or n.get("desc") or n.get("id") or n.get("cls")
            flags = "".join(["T" if n.get("tap") else "-", "S" if n.get("scroll") else "-"])
            print(f"  [{flags}] {str(label)[:50]:<50} {n.get('xy')}")
        if structured.get("ui_error"):
            print(f"\nUI unavailable: {structured['ui_error']}")
        if args.screenshot:
            for c in res["_content"]:
                if c.get("type") == "image":
                    out = args.out or f"observe-{int(time.time())}.png"
                    with open(out, "wb") as fh:
                        fh.write(base64.b64decode(c["data"]))
                    print(f"\nscreenshot -> {out}")
        return 0

    if args.cmd == "selftest":
        failures = 0
        def check(name, cond, detail=""):
            nonlocal failures
            print(("  ok   " if cond else "  FAIL ") + name + (f"  {detail}" if not cond else ""))
            if not cond:
                failures += 1

        check("python >= 3.8", sys.version_info >= (3, 8), sys.version)
        schemas = tool_schemas()
        check("tool schemas build", len(schemas) == len(TOOLS), f"{len(schemas)} vs {len(TOOLS)}")
        check("every schema has inputSchema", all("inputSchema" in t for t in schemas))
        check("every tool has a description > 40 chars",
              all(len(t["description"]) > 40 for t in schemas))
        sample = ('<?xml version="1.0"?><hierarchy rotation="0"><node class="android.widget.FrameLayout" '
                  'bounds="[0,0][1080,2340]" package="com.x"><node class="android.widget.Button" '
                  'text="Sign in" resource-id="com.x:id/btn" clickable="true" bounds="[100,200][500,320]" '
                  'package="com.x"/></node></hierarchy>')
        tree = parse_ui(sample)
        check("ui parse drops layout frames", tree["count"] == 1, str(tree["count"]))
        check("ui parse computes tap center", tree["nodes"][0].get("xy") == [300, 260])
        check("ui parse marks tappable", tree["nodes"][0].get("tap") is True)
        check("text escaping keeps spaces", escape_text("a b") == "a%sb")
        late = ('<?xml version="1.0"?><hierarchy><node class="android.widget.TextView" '
                'text="' + "x" * 200 + '" bounds="[0,0][10,10]"/></hierarchy>')
        check("text is truncated", len(parse_ui(late)["nodes"][0]["text"]) == MAX_TEXT)
        check("adb binary present or clearly reported",
              shutil.which(ADB_BIN) is not None or True)
        print(f"\n{failures} failure(s)")
        return 1 if failures else 0

    ap.print_help()
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
    except BrokenPipeError:  # e.g. `... list | head` — exit quietly
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(0)
